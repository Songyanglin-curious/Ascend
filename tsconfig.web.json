{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": ["vite.config.ts", "web/src/**/*.ts", "web/src/**/*.tsx"],
  "exclude": ["web/src/**/*.next.ts", "web/src/**/*.next.tsx"]
}
